{
  "name": "starlight-tech-radar",
  "version": "1.0.0",
  "description": "This project is an open source tech radar, inspired by the ThoughtWorks Tech Radar.",
  "productName": "Starlight Tech Radar",
  "author": "\"Ele\" <starlight-tech-radar@ele.codes>",
  "type": "module",
  "private": false,
  "license": "MIT",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "npm run test:unit",
    "test:update": "vitest run --update",
    "test:unit": "vitest run --coverage",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ci": "playwright test --reporter=list",
    "test:e2e:ui": "playwright test --ui",
    "test:performance": "CHROME_PATH=$(node -e \"console.log(require('@playwright/test').chromium.executablePath())\") lighthouse http://127.0.0.1:3000 --output=json --output-path=./lighthouse-report-prod.json --chrome-flags=\"--headless --no-sandbox\"",
    "test:performance:summary": "node -e \"const r = require('./lighthouse-report-prod.json'); console.log({ FCP: r.audits['first-contentful-paint'].displayValue, LCP: r.audits['largest-contentful-paint'].displayValue, TBT: r.audits['total-blocking-time'].displayValue, CLS: r.audits['cumulative-layout-shift'].displayValue, Score: r.categories.performance.score })\"",
    "type-check": "vue-tsc --noEmit",
    "test:all": "npm run type-check && npm run test:unit && npm run test:e2e",
    "test:audit": "npm audit --omit=dev",
    "wiremock:up": "docker compose up -d",
    "wiremock:down": "docker compose down",
    "dev": "quasar dev -m ssr",
    "build": "quasar build -m ssr",
    "serve:prod": "node dist/ssr/index.js",
    "serve:prod:stop": "pkill -f 'node dist/ssr/index.js' || true && rm -rf *Local\\lighthouse.*",
    "postinstall": "quasar prepare && npx playwright install",
    "prepare": "husky"
  },
  "dependencies": {
    "@blueoak/list": "^15.0.0",
    "@quasar/extras": "^1.16.4",
    "axios": "^1.2.1",
    "pinia": "^3.0.1",
    "quasar": "^2.16.0",
    "serverless-http": "^4.0.0",
    "vue": "^3.5.22",
    "vue-i18n": "^11.0.0",
    "vue-router": "^5.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@eslint/js": "^9.14.0",
    "@fontsource/opendyslexic": "^5.2.5",
    "@fontsource/roboto": "^5.2.10",
    "@intlify/unplugin-vue-i18n": "^11.0.7",
    "@pinia/testing": "^1.0.3",
    "@playwright/test": "^1.58.2",
    "@quasar/app-vite": "^2.1.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.6",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@types/node": "^20.5.9",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vitest/coverage-istanbul": "^4.0.18",
    "@vitest/coverage-v8": "^4.0.18",
    "@vue/eslint-config-typescript": "^14.4.0",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.2",
    "axe-core": "^4.11.1",
    "eslint": "^9.14.0",
    "eslint-plugin-vue": "^10.4.0",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.2.0",
    "jsdom": "^28.1.0",
    "lighthouse": "^13.0.3",
    "lighthouse-badges": "^1.4.4",
    "neostandard": "^0.12.2",
    "nyc": "^18.0.0",
    "semantic-release": "^25.0.3",
    "typescript": "^5.9.2",
    "vite-plugin-checker": "^0.11.0",
    "vite-plugin-istanbul": "^7.2.1",
    "vitest": "^4.0.18",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.0.7"
  },
  "engines": {
    "node": "^24",
    "npm": ">= 6.13.4",
    "yarn": ">= 1.21.1",
    "pnpm": ">= 10.0.0"
  },
  "overrides": {
    "serialize-javascript": "^7.0.3",
    "minimatch": "10.2.4"
  }
}
